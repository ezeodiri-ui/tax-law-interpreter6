# ---- Answer model (swap freely; no code changes) ------------------------------
# LLM_PROVIDER: groq | gemini | openrouter | ollama | openai_compat | anthropic
LLM_PROVIDER=groq
GROQ_API_KEY=            # free key: console.groq.com
# GEMINI_API_KEY=        # free key: aistudio.google.com
# OPENROUTER_API_KEY=    # openrouter.ai (models ending in :free)
# ANTHROPIC_API_KEY=     # paid
# LLM_MODEL=             # optional override, spelled as the provider lists it
# LLM_BASE_URL=          # only for openai_compat (vLLM, LM Studio, any hosted endpoint)

# ---- Retrieval ------------------------------------------------------------------
# st (local bge embeddings) | voyage | lsa (offline) | none
DENSE_BACKEND=st
EMBED_MODEL=BAAI/bge-base-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-v2-m3
TOP_K=8

# ---- Access control (set before sharing a link) --------------------------------------
APP_USER=committee
APP_PASSWORD=            # choose a strong shared password; empty = no login
RATE_LIMIT_PER_MIN=20
